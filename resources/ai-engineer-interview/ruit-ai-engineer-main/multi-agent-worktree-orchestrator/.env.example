# OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-token-here
OPENROUTER_MODEL=google/gemini-2.5-flash
# Alternative supported model: deepseek/deepseek-chat

# Claude Code Headless CLI Routing via OpenRouter
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-v1-your-openrouter-token-here
ANTHROPIC_API_KEY=""

# Orchestrator Concurrency Limits
MAX_CONCURRENT_AGENTS=4
TOTAL_AGENTS=16

